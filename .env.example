# Author: ramanpal singh | URL: https://kwebby.com
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
PUBLIC_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
TRUST_PROXY_HOPS=0
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://clinic:CHANGE_ME@127.0.0.1:5432/clinic
DATABASE_PASSWORD=CHANGE_ME
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_INDEPENDENT_ADMIN_SECRET
MYSQL_ROOT_PASSWORD=CHANGE_ME_INDEPENDENT_MYSQL_ROOT_SECRET
VALKEY_PASSWORD=CHANGE_ME_RANDOM_HEX
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_FILE=
REDIS_URL=redis://127.0.0.1:6379
APP_ENCRYPTION_KEY=GENERATE_BASE64_32_BYTES
BOOTSTRAP_TOKEN=GENERATE_BOOTSTRAP_TOKEN
ORGANIZATION_ID=clinic
INSTALLATION_ID=clinic
INSTALLATION_AUDIENCE=patient
REGISTRATION_ENABLED=true
REQUIRE_STAFF_MFA=true
PRIVATE_STORAGE_ROOT=.runtime/files
OUTBOUND_WORKERS_ENABLED=false
AI_ALLOWED_HOSTS=api.openai.com
OPENAPI_ENABLED=false
CLINIC_DOMAIN=clinic.example.com
PDF_RENDERER_SOCKET=
ANALYZER_SOCKET=
# Production: HTTPS origin, API_HOST=0.0.0.0 behind proxy, TRUST_PROXY_HOPS=1.
# Compose sets service addresses and private paths. Keep outbound disabled during restore.
# Managed SQL requires a TLS URL. Cloud Firestore uses service-account credentials on API/worker only.

# Optional local scanner config; production Compose uses /etc/clamav/clamd.conf.
CLAMD_CONFIG=
MAINTENANCE_MODE=false
# Set privately only for offline export/import; use a distinct random 32-byte key.
DATA_TRANSFER_KEY=
