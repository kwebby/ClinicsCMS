{
  "name": "clinicscms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'pnpm dev:api' 'pnpm dev:web'",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "pnpm --filter @clinic/web dev",
    "worker": "tsx apps/worker/src/main.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @clinic/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "vitest run tests/persistence",
    "build": "tsc -p tsconfig.build.json && pnpm --filter @clinic/web build",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "certify": "tsx scripts/certify.ts",
    "test:e2e": "playwright test",
    "data:export": "tsx scripts/data-transfer.ts export",
    "data:import": "tsx scripts/data-transfer.ts import",
    "deploy:init": "tsx scripts/deployment.ts init",
    "deploy:check": "tsx scripts/deployment.ts check",
    "test:load-smoke": "tsx scripts/http-load.ts",
    "deploy:verify": "tsx scripts/verify-deployment.ts",
    "theme:package": "tsx scripts/theme-package.ts",
    "start:web": "pnpm --filter @clinic/web start"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/platform-socket.io": "12.1.2",
    "@nestjs/websockets": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@blocknote/core": "0.55.0",
    "@blocknote/server-util": "0.55.0",
    "bcryptjs": "3.0.2",
    "bullmq": "6.3.12",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "firebase-admin": "14.5.0",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "kysely": "0.29.6",
    "mysql2": "3.24.5",
    "nodemailer": "10.0.16",
    "otpauth": "9.4.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "socket.io": "4.8.1",
    "stripe": "19.1.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/node": "24.9.1",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "8.15.5",
    "@types/sanitize-html": "2.16.0",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.0",
    "concurrently": "9.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "license-checker-rseidelsohn": "5.0.1"
  },
  "author": {
    "name": "ramanpal singh",
    "url": "https://kwebby.com"
  },
  "description": "Self-hosted clinic operations, patient portal and website CMS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kwebby/ClinicsCMS.git"
  },
  "homepage": "https://github.com/kwebby/ClinicsCMS#readme",
  "bugs": {
    "url": "https://github.com/kwebby/ClinicsCMS/issues"
  }
}
