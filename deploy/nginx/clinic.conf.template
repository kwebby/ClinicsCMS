map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server { listen 80 default_server; server_name _; return 444; }
server { listen 80; server_name ${CLINIC_DOMAIN}; return 308 https://$host$request_uri; }
server {
  listen 443 ssl default_server;
  server_name ${CLINIC_DOMAIN};
  if ($host != ${CLINIC_DOMAIN}) { return 444; }
  ssl_certificate /etc/clinic/tls/fullchain.pem;
  ssl_certificate_key /etc/clinic/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  server_tokens off;
  client_max_body_size 26m;
  client_body_timeout 30s;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_hide_header X-Powered-By;
  proxy_http_version 1.1;
  location /api/ {
    proxy_pass http://api:4000;
    proxy_buffering off;
    proxy_read_timeout 70s;
    # Any add_header here replaces every inherited one, so the server-level security headers are repeated.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control "private, no-store" always;
  }
  location /socket.io/ {
    proxy_pass http://api:4000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 90s;
  }
  location / { proxy_pass http://web:3000; }
}
